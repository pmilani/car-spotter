# Render environment variables
# Set these in Render -> your Web Service -> Environment.
# Do not commit your real album URL.
# Keep the quotes if the URL contains #.
ALBUM_URL="https://www.icloud.com/sharedalbum/#PASTE_YOUR_TOKEN_HERE"
# Exact GitHub Pages origin, e.g. https://yourname.github.io
ALLOWED_ORIGIN=https://YOUR_GITHUB_USERNAME.github.io
